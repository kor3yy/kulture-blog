---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const postsWithThumbs = posts.map((post) => {
  const match = post.body.match(/src="([^"]*\.(jpg|jpeg|png|gif|webp))"/i);
  const firstImage = match ? match[1] : post.data.thumbnail;
  return { ...post, firstImage };
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Blog — Kulture</title>
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body>
    <header>
      <nav>
        <a href="/" class="logo">Kulture</a>
        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/about">About</a>
        </div>
      </nav>
    </header>

    <main>
      <h1>All Posts</h1>
      <ul class="post-list">
        {postsWithThumbs.map((post) => (
          <li class="post-card">
            <a href={`/blog/${post.slug}/`}>
              {post.firstImage && (
                <img src={post.firstImage} alt={post.data.title} class="post-thumbnail" />
              )}
              <h3>{post.data.title}</h3>
              <p class="post-date">{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
              <p>{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </main>

    <footer>
      <p>&copy; {new Date().getFullYear()} Kulture. All rights reserved.</p>
    </footer>
  </body>
</html>
