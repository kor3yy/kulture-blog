---
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');

const pinnedPosts = allPosts
  .filter((post) => post.data.pinned)
  .sort((a, b) => (b.data.pubDate?.valueOf() || 0) - (a.data.pubDate?.valueOf() || 0));

const otherPosts = allPosts
  .filter((post) => !post.data.pinned)
  .sort((a, b) => (b.data.pubDate?.valueOf() || 0) - (a.data.pubDate?.valueOf() || 0));

const posts = [...pinnedPosts, ...otherPosts];

const postsWithThumbs = posts.map((post) => {
  const match = post.body && post.body.match(/src="([^"]*\.(jpg|jpeg|png|gif|webp))"/i);
  const firstImage = match ? match[1] : post.data.thumbnail;
  return { ...post, firstImage };
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Turath</title>
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body class="home">
    <header>
      <nav>
        <a href="/" class="logo">Turath</a>
        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/about">About</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="hero">
        <h1>Welcome to Turath</h1>
        <p>Stories, ideas, and perspectives worth sharing.</p>
      </section>

      <section class="posts">
        <h2>Latest Posts</h2>
        <ul class="post-list">
          {postsWithThumbs.map((post) => (
            <li class="post-card">
              <a href={`/blog/${post.slug}/`}>
                {post.firstImage && (
                  <img src={post.firstImage} alt={post.data.title} class="post-thumbnail" />
                )}
                <h3>{post.data.title}</h3>
                <p class="post-date">{post.data.pubDate ? post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : ''}</p>
                <p>{post.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </main>

    <footer>
      <p>&copy; {new Date().getFullYear()} Turath. All rights reserved.</p>
    </footer>
  </body>
</html>
/* GIF background — front page only */
body.home {
  background-image: url('/images/background.gif');
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  background-repeat: no-repeat;
}

/* Make post cards readable over the GIF */
body.home .post-card a {
  background: rgba(255, 255, 255, 0.92);
}

body.home .hero {
  background: rgba(255, 255, 255, 0.85);
  border-radius: 12px;
  padding: 2rem 1rem;
}
